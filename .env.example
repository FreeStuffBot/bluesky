# Example environment variables for FreeStuff Bluesky Bot

BSKY_IDENTIFIER=your-bluesky-identifier-or-email
BSKY_PASSWORD=your-bluesky-password-or-app-specific-password
BSKY_SERVICE_URL=https://bsky.social
# Optional: JSON array of allowed product types. If omitted, all types are posted.
# BSKY_ALLOWED_TYPES=["keep","timed"]
FREESTUFF_PUBLIC_KEY=your-freestuff-event-public-key
FREESTUFF_API_KEY=your-freestuff-rest-api-key
# Optional: Discord webhook URL for error and filter notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
